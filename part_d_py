# -------------------------
# Task 1: policy chunking
# -------------------------

def chunk_text(text, chunk_size=40, overlap=10):
    words = text.split()
    chunks = []
    start = 0

    while start < len(words):
        end = start + chunk_size
        chunks.append(" ".join(words[start:end]))
        if end >= len(words):
            break
        start += chunk_size - overlap

    return chunks


all_chunks = []
for file_path in sorted(POLICY_DIR.glob("*.txt")):
    for chunk in chunk_text(file_path.read_text(encoding="utf-8")):
        all_chunks.append({"source": file_path.name, "text": chunk})

print("Total chunks:", len(all_chunks))
for source in sorted({chunk["source"] for chunk in all_chunks}):
    print(source, ":", sum(1 for chunk in all_chunks if chunk["source"] == source))


# -------------------------
# Task 2: TF-IDF retrieval
# -------------------------

chunk_texts = [chunk["text"] for chunk in all_chunks]
vectorizer = TfidfVectorizer()
tfidf_matrix = vectorizer.fit_transform(chunk_texts)


def retrieve(query, k=3):
    query_vector = vectorizer.transform([query])
    scores = cosine_similarity(query_vector, tfidf_matrix).flatten()
    ranked_indices = scores.argsort()[::-1][:k]

    return [
        {
            "source": all_chunks[index]["source"],
            "score": float(scores[index]),
            "text": all_chunks[index]["text"],
        }
        for index in ranked_indices
    ]


# -------------------------
# Task 3: RAG policy assistant
# -------------------------

def answer(question):
    results = retrieve(question, k=3)
    context = "\n".join(
        f'[{item["source"]}]\n{item["text"]}' for item in results
    )
    messages = [
        {
            "role": "system",
            "content": (
                "POLICY ASSISTANT. Answer the question only using the supplied "
                "context. Do not use outside knowledge. If the context does not "
                "contain the answer, say 'I could not find the information in "
                "the supplied policy documents.'"
            ),
        },
        {
            "role": "user",
            "content": f"CONTEXT:\n{context}\nQUESTION:\n{question}",
        },
    ]
    response = mock_llm.chat(messages)
    return {
        "answer": response.choices[0].message.content,
        "sources": list(dict.fromkeys(item["source"] for item in results)),
    }


# -------------------------
# Task 4: evaluation
# -------------------------

def build_retriever(overlap):
    chunks = []
    for file_path in sorted(POLICY_DIR.glob("*.txt")):
        words = file_path.read_text(encoding="utf-8").split()
        start = 0

        while start < len(words):
            end = start + 40
            chunks.append({
                "source": file_path.name,
                "text": " ".join(words[start:end]),
            })
            if end >= len(words):
                break
            start += 40 - overlap

    texts = [chunk["text"] for chunk in chunks]
    vec = TfidfVectorizer()
    matrix = vec.fit_transform(texts)
    return chunks, vec, matrix


def retrieve_from(query, chunks, vec, matrix, k=3):
    query_vector = vec.transform([query])
    scores = cosine_similarity(query_vector, matrix).flatten()
    ranked = scores.argsort()[::-1][:k]

    return [
        {
            "source": chunks[index]["source"],
            "score": float(scores[index]),
            "text": chunks[index]["text"],
        }
        for index in ranked
    ]


def answer_from(question, chunks, vec, matrix):
    results = retrieve_from(question, chunks, vec, matrix, k=3)
    context = "\n".join(
        f'[{item["source"]}]\n{item["text"]}' for item in results
    )
    messages = [
        {
            "role": "system",
            "content": (
                "POLICY ASSISTANT. Answer only from the supplied context. If "
                "the information is not found, say 'I could not find the "
                "information in the supplied policy documents.'"
            ),
        },
        {
            "role": "user",
            "content": f"CONTEXT:\n{context}\nQUESTION:\n{question}",
        },
    ]
    response = mock_llm.chat(messages)
    return response.choices[0].message.content, results


def evaluate(overlap):
    chunks, vec, matrix = build_retriever(overlap)
    df = pd.read_csv(EVAL_FILE).fillna("")
    answerable_doc_hits = 0
    answerable_fact_hits = 0
    unanswerable_fallback_hits = 0
    failures = []

    for _, row in df.iterrows():
        question = row["question"]
        expected_doc = row["expected_doc"]
        expected_fact = row["expected_fact"]
        answer_text, results = answer_from(question, chunks, vec, matrix)
        sources = [item["source"] for item in results]

        if expected_doc == "NONE":
            if answer_text.startswith("I could not find"):
                unanswerable_fallback_hits += 1
            else:
                failures.append({
                    "question": question,
                    "reason": "Unanswerable question did not get fallback",
                })
        else:
            doc_hit = expected_doc in sources
            fact_hit = expected_fact in answer_text
            answerable_doc_hits += int(doc_hit)
            answerable_fact_hits += int(fact_hit)

            if not doc_hit or not fact_hit:
                failures.append({
                    "question": question,
                    "doc_hit": doc_hit,
                    "fact_hit": fact_hit,
                })

    print(f"\nEvaluation with overlap = {overlap}")
    print("Chunks:", len(chunks))
    print("Answerable document hits:", answerable_doc_hits, "/ 12")
    print("Answerable expected-fact hits:", answerable_fact_hits, "/ 12")
    print("Unanswerable fallback hits:", unanswerable_fallback_hits, "/ 2")
    print("\nFailed questions:")
    for failure in failures:
        print(failure)

    return failures


