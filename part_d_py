# Task 6-8: ReAct loop, safeguards, checkpoints
# -------------------------

def save_checkpoint(run_id, state):
    path = STATE_DIR / f"{run_id}.json"
    with path.open("w", encoding="utf-8") as file:
        json.dump(state, file, indent=2)


def load_checkpoint(run_id):
    path = STATE_DIR / f"{run_id}.json"
    with path.open("r", encoding="utf-8") as file:
        return json.load(file)


def _tool_call_fields(tool_call):
    """The supplied mock emits SimpleNamespace calls with name/arguments directly."""
    if hasattr(tool_call, "function"):
        name = tool_call.function.name
        arguments = tool_call.function.arguments
    else:
        name = tool_call.name
        arguments = tool_call.arguments

    if isinstance(arguments, str):
        arguments = json.loads(arguments)
    return name, arguments


def run_agent(
    scenario_id,
    order_id,
    run_id=None,
    token_limit=6000,
    time_limit_seconds=30,
    max_iterations=10,
    resume=False,
    crash_after_tool=None,
):
    if run_id is None:
        run_id = str(uuid.uuid4())

    started_at = time.monotonic()

    if resume:
        state = load_checkpoint(run_id)
        messages = state["messages"]
        tokens_used = state["tokens_used"]
        tool_executions = state["tool_executions"]
        model_calls = state["model_calls"]
        step = state["step"]
    else:
        messages = [
            {
                "role": "system",
                "content": (
                    "AGENT: You are a safe Instamart refund support agent. "
                    "Use tools to inspect orders and policy. Only completed "
                    "orders may be refunded. Late delivery is over 45 minutes. "
                    "Refunds above INR 1000 require human approval. Never issue "
                    "a refund before checking order status."
                ),
            },
            {
                "role": "user",
                "content": f"Please review the refund request for order {order_id}.",
            },
        ]
        tokens_used = 0
        tool_executions = []
        model_calls = 0
        step = 0

    while model_calls < max_iterations:
        if time.monotonic() - started_at >= time_limit_seconds:
            return {
                "run_id": run_id,
                "scenario_id": scenario_id,
                "status": "FALLBACK_TIMEOUT",
                "final_answer": "Human handoff: agent time limit reached.",
                "tokens_used": tokens_used,
                "model_calls": model_calls,
                "tool_executions": tool_executions,
            }

        response = mock_llm.chat(messages, tools=TOOLS_SPEC)
        model_calls += 1
        tokens_used += response.usage.total_tokens

        if tokens_used > token_limit:
            return {
                "run_id": run_id,
                "scenario_id": scenario_id,
                "status": "FALLBACK_TOKEN_LIMIT",
                "final_answer": "Human handoff: token limit reached.",
                "tokens_used": tokens_used,
                "model_calls": model_calls,
                "tool_executions": tool_executions,
            }

        message = response.choices[0].message
        tool_calls = getattr(message, "tool_calls", None)

        if not tool_calls:
            final_answer = message.content or "Human handoff: no final answer."
            status = final_answer.split(":", 1)[0]
            return {
                "run_id": run_id,
                "scenario_id": scenario_id,
                "status": status,
                "final_answer": final_answer,
                "tokens_used": tokens_used,
                "model_calls": model_calls,
                "tool_executions": tool_executions,
            }

        # The mock's tool results are read from role="tool" messages.
        # Save each observation immediately so a resume does not repeat a tool.
        for tool_call in tool_calls:
            tool_name, arguments = _tool_call_fields(tool_call)
            if tool_name not in TOOL_MAP:
                observation = {"error": f"unknown tool: {tool_name}"}
            else:
                observation = TOOL_MAP[tool_name](**arguments)

            tool_executions.append(tool_name)
            step += 1

            tool_message = {
                "role": "tool",
                "name": tool_name,
                "content": json.dumps(observation),
                "tool_call_id": getattr(tool_call, "id", f"call_{step}"),
            }
            messages.append(tool_message)

            state = {
                "run_id": run_id,
                "scenario_id": scenario_id,
                "messages": messages,
                "tokens_used": tokens_used,
                "tool_executions": tool_executions,
                "model_calls": model_calls,
                "step": step,
            }
            save_checkpoint(run_id, state)

            if crash_after_tool is not None and step == crash_after_tool:
                raise RuntimeError("SIMULATED_CRASH")

    return {
        "run_id": run_id,
        "scenario_id": scenario_id,
        "status": "FALLBACK_MAX_ITERATIONS",
        "final_answer": "Human handoff: maximum agent iterations reached.",
        "tokens_used": tokens_used,
        "model_calls": model_calls,
        "tool_executions": tool_executions,
    }


